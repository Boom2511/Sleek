// libs/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  bookings  Booking[]

}
model Station {
  id        String    @id @default(uuid())
  name      String
  location  String
  chargers  Charger[]
  createdAt DateTime  @default(now())
}

model Charger {
  id         String    @id @default(uuid())
  stationId  String
  station    Station   @relation(fields: [stationId], references: [id])
  type       String    
  status     String    
  bookings   Booking[]
}

model Booking {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  chargerId     String
  charger       Charger  @relation(fields: [chargerId], references: [id])
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([chargerId])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}